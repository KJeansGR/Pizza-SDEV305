<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>

    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>admin/orders</title>
</head>
<body>
   <table id="order-table" class="display">
        <thead>
            <tr>
                <th> order#</th>
                <th> First Name</th>
                <th> Last Name</th>
                <th> Email</th>
                <th> Size</th>
                <th> Method</th>
                <th> Toppings</th>
                <!-- <th> Comment</th> -->
                <th> Timestamp</th>     
            </tr>
        </thead>
        <thead>
        <% orders.forEach(order => {%>
            <tr>
            <% Object.entries(order).forEach(o => {%>
            <td><%= o[1] %></td>
           <% })%>
                           
            </tr>
    <% })%>

        </thead>
   </table>
       <script defer>
        let table = new DataTable('#order-table');
    </script>
</body>
</html>